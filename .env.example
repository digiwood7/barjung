# ── 고객 Supabase (로컬 관리자 서버 + Windows 실행기 + Python 업로더가 함께 사용) ──
# 두 값이 모두 있으면 관리자 화면이 "고객 DB 연결" 모드로, 비어 있으면 "데모 데이터" 모드로 동작합니다.
# service role 키는 고객 PC 안에서만 쓰고 브라우저·Git·외부 메시지에 절대 넣지 않습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 사업장 UUID. 비우면 offices 테이블의 첫 행(seed: 00000000-0000-4000-8000-000000000001)을 씁니다.
BARJUNG_OFFICE_ID=
# true 로 두면 저장 요청(POST/PATCH/DELETE)을 403 으로 막습니다. Vercel 조회 전용 배포에서만 사용합니다.
BARJUNG_READ_ONLY=false

# ── 브라우저 노출 가능 값 (현재 화면 코드는 사용하지 않음 — 관리자 로그인 도입 후 브라우저 직접 접속용) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Windows 실행기 전용 ──
BARJUNG_AGENT_ID=00000000-0000-4000-8000-000000000101
BARJUNG_RUNNER_POLL_MS=5000
BARJUNG_PLAYWRIGHT_PROFILE_DIR=
BARJUNG_RUNNER_MEDIA_DIR=tmp/runner-media
BARJUNG_HEADLESS=false

# ── 고객이 발급한 공공데이터 API 값 (없으면 건축물대장 자동 조회를 건너뛰고 직원이 직접 입력) ──
JUSO_API_BASE_URL=https://business.juso.go.kr/addrlink/addrLinkApi.do
JUSO_API_KEY=
BUILDING_REGISTER_API_BASE_URL=
BUILDING_REGISTER_API_KEY=
