# ── 고객 Supabase (로컬 관리자 서버 + Windows 실행기 + Python 업로더가 함께 사용) ──
# 두 값이 모두 있으면 관리자 화면이 "고객 DB 연결" 모드로, 비어 있으면 "데모 데이터" 모드로 동작합니다.
# service role 키는 고객 PC 안에서만 쓰고 브라우저·Git·외부 메시지에 절대 넣지 않습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 사업장 UUID. 비우면 offices 테이블의 첫 행(seed: 00000000-0000-4000-8000-000000000001)을 씁니다.
BARJUNG_OFFICE_ID=
# true 로 두면 로컬 저장 요청(POST/PATCH/DELETE)을 403 으로 막습니다. 점검·시연 때만 사용합니다.
BARJUNG_READ_ONLY=false

# ── 브라우저 노출 가능 값 (현재 화면 코드는 사용하지 않음 — 관리자 로그인 도입 후 브라우저 직접 접속용) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 관리자 브라우저가 고객 PC 사진 실행기에 원본을 직접 전달하는 loopback 주소입니다.
NEXT_PUBLIC_BARJUNG_RUNNER_URL=http://127.0.0.1:43127

# ── Windows 실행기 전용 ──
BARJUNG_AGENT_ID=00000000-0000-4000-8000-000000000101
BARJUNG_RUNNER_POLL_MS=5000
BARJUNG_PLAYWRIGHT_PROFILE_DIR=
BARJUNG_RUNNER_MEDIA_DIR=tmp/runner-media
BARJUNG_RUNNER_MEDIA_PORT=43127
# 쉼표 구분. 운영 도메인과 로컬 관리자 주소만 허용합니다.
BARJUNG_RUNNER_ALLOWED_ORIGINS=https://barjeong.vercel.app,http://localhost:3000,http://127.0.0.1:3000
BARJUNG_HEADLESS=false
# 관리자 사진 업로드에 사용할 Python. 비우면 python/.venv/Scripts/python.exe 를 자동 사용합니다.
BARJUNG_PYTHON=

# ── 네이버 블로그 어댑터 (Windows 실행기) ──
# true 로 켜기 전에 고객 PC에서 `npm --prefix runner run naver:login` 으로 로그인하고 headed 로 한 번 검증합니다.
BARJUNG_NAVER_ENABLED=false
# draft = 임시저장까지만(기본, 안전) · publish = 발행 버튼까지 누름
BARJUNG_NAVER_MODE=draft
# 발행 후 글 주소 확인용 블로그 ID (RSS https://rss.blog.naver.com/<ID>.xml)
BARJUNG_NAVER_BLOG_ID=
# 발행 레이어에서 고를 카테고리명(비우면 기본 카테고리). 못 고르면 발행하지 않습니다.
BARJUNG_NAVER_CATEGORY=
# 글 끝 문의 줄. | 로 줄 구분
BARJUNG_NAVER_CONTACT=문의 카톡 : room5555|연락처 : 010-0000-0000
# 고정 해시태그(쉼표 구분). 지역·유형 자동 태그(#대구원룸 #산격동원룸)는 BARJUNG_NAVER_AUTO_HASHTAGS=false 로 끌 수 있음
BARJUNG_NAVER_HASHTAGS=경북대원룸
# 설치된 크롬을 쓰고(chrome) 없으면 내장 Chromium 으로 폴백
BARJUNG_NAVER_CHANNEL=chrome

# ── 고객이 발급한 공공데이터 API 값 (없으면 건축물대장 자동 조회를 건너뛰고 직원이 직접 입력) ──
JUSO_API_BASE_URL=https://business.juso.go.kr/addrlink/addrLinkApi.do
JUSO_API_KEY=
BUILDING_REGISTER_API_BASE_URL=
BUILDING_REGISTER_API_KEY=
